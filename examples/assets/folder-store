#!/bin/sh
# bay's reference assets plugin: keeps each large file's bytes in one folder, named by its
# SHA-256. The folder can be any directory every machine of the team reaches: a disk, a NAS, a
# mounted shared drive. Copy this file into the repository (for example scripts/folder-store),
# make it executable, and name the folder after it in .bay/config.toml:
#
#   [plugin.assets]
#   command = "scripts/folder-store /Volumes/studio/bay-assets"
#   over_limit = "offload"
#
# bay runs it as (crate::assets), and hashes every file itself:
#   <command> put <file>                       store the bytes, print sha256:<hex>
#   <command> get <id> <file> [<start> <end>]  write the bytes (or bytes start..end); exit 3 if purged
#   <command> exists <id>                      exit 0 held, 1 not held, 3 purged
#   <command> purge <id>                       drop the bytes, keep the address (a takedown)
# Check it with: bay plugin test assets -- scripts/folder-store <folder>
set -eu

store=${1:?"name the store's folder after the command"}
action=${2:-}

hash() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

case "$action" in
put)
    file=${3:?"put needs a file"}
    mkdir -p "$store"
    hex=$(hash "$file")
    if [ ! -f "$store/$hex" ]; then
        # Written beside its place, then renamed: a reader never sees half a file.
        cp "$file" "$store/.$hex.$$"
        mv "$store/.$hex.$$" "$store/$hex"
    fi
    rm -f "$store/$hex.purged"
    echo "sha256:$hex"
    ;;
get)
    id=${3:?"get needs an identity"}
    out=${4:?"get needs a file to write"}
    hex=${id#sha256:}
    if [ -f "$store/$hex.purged" ]; then
        echo "folder-store: $id was purged" >&2
        exit 3
    fi
    if [ ! -f "$store/$hex" ]; then
        echo "folder-store: $id is not in $store" >&2
        exit 1
    fi
    if [ $# -ge 6 ]; then
        start=$5
        end=$6
        tail -c +"$((start + 1))" "$store/$hex" | head -c "$((end - start))" > "$out"
    else
        cp "$store/$hex" "$out"
    fi
    ;;
exists)
    hex=${3:?"exists needs an identity"}
    hex=${hex#sha256:}
    if [ -f "$store/$hex.purged" ]; then
        exit 3
    fi
    if [ ! -f "$store/$hex" ]; then
        exit 1
    fi
    ;;
purge)
    hex=${3:?"purge needs an identity"}
    hex=${hex#sha256:}
    mkdir -p "$store"
    rm -f "$store/$hex"
    : > "$store/$hex.purged"
    ;;
*)
    echo "folder-store: the actions are put, get, exists and purge" >&2
    exit 2
    ;;
esac
