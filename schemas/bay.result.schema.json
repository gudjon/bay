{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bay.result/1",
  "description": "The one result every bay command prints on stdout.",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "say"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "reason": [
      "allowed",
      "retry_when",
      "next_step"
    ]
  },
  "properties": {
    "schema": {
      "const": "bay.result/1"
    },
    "op_id": {
      "type": "string"
    },
    "candidate": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "ok",
        "merged",
        "queued",
        "blocked",
        "failed"
      ]
    },
    "state": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "INPUT_CHANGED",
        "INPUT_UNOBSERVED",
        "MERGE_CONFLICT",
        "MAIN_MOVED",
        "MERGE_RETRY_EXHAUSTED",
        "REGISTRY_CHANGED",
        "CHECK_FLAKY",
        "CHANGE_NOT_MERGED",
        "HOOK_TIMEOUT",
        "QUEUED",
        "QUEUE_DEADLINE_EXCEEDED",
        "CHECK_FAILED",
        "CHECK_UNAVAILABLE",
        "CHECK_UNKNOWN",
        "POLICY_CHANGED",
        "POLICY_INVALID",
        "POLICY_MISSING",
        "WORKSPACE_INCOMPLETE",
        "MERGE_OUTCOME_UNKNOWN",
        "MAIN_RED",
        "CHANGE_ALREADY_MERGED",
        "CHANGE_SUPERSEDED",
        "CHANGE_HELD",
        "ABANDON_REFUSED",
        "ACTOR_UNNAMED",
        "ACTOR_UNPROVEN",
        "COVERAGE_UNKNOWN",
        "HOOK_INPUT_INVALID",
        "SHELL_DENIED",
        "PATH_HELD",
        "REMOTE_NOT_FETCHED",
        "CONFIG_MISSING",
        "TOOL_BELOW_FLOOR",
        "TOOL_ABSENT",
        "REMOTE_UNREACHABLE",
        "HOOKS_MISSING",
        "SKILL_MISMATCH",
        "SANDBOX_ABSENT",
        "CHECK_ENV_UNSET",
        "RUNNER_KEY_MISSING",
        "KEY_EXPOSED",
        "UPDATE_UNAVAILABLE",
        "UPDATE_UNVERIFIED",
        "UPDATE_PINNED",
        "TALK_REFUSED",
        "OUTSIDE_MERGE",
        "EVIDENCE_WITHDRAWN",
        "PROMOTION_REFUSED",
        "LANE_LEAK",
        "APPROVAL_PENDING",
        "WIP_LIMIT",
        "DISK_LOW",
        "MAIN_HELD",
        "PATHS_UNDECLARED",
        "DEPENDENCY_PENDING",
        "DEPENDENCY_ABANDONED",
        "CHANGE_TOO_LARGE"
      ]
    },
    "say": {
      "type": "string"
    },
    "change": {
      "type": "string"
    },
    "detail": {},
    "allowed": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "refresh",
          "repair",
          "wait"
        ]
      }
    },
    "retry_when": {
      "enum": [
        "candidate_validated_against_required_versions",
        "required_version_read",
        "conflict_paths_changed",
        "retried_once_then_queued",
        "cause_fixed",
        "resigned_by_valid_executor",
        "check_fixed_or_quarantined",
        "change_landed",
        "retried_after_short_wait",
        "reached_queue_head",
        "operation_changed_or_budget_raised",
        "candidate_changed",
        "capable_worker_reachable",
        "check_produced_result",
        "rechecked_under_current_policy",
        "policy_repaired",
        "policy_added",
        "journal_ready",
        "trunk_read_again",
        "trunk_green_or_change_names_the_owner",
        "never",
        "existing_change_landed_abandoned_or_past_takeover",
        "holder_session_ended_or_heartbeat_past_takeover_window",
        "current_actor_abandons_or_adopt_rules_apply",
        "bay_actor_set",
        "actor_key_on_hardware_or_own_account",
        "coordination_data_reachable",
        "hook_payload_readable_by_this_bay",
        "holder_session_stopped_or_claim_past_deadline",
        "remote_fetched",
        "config_added",
        "tool_upgraded_or_adapter_removed",
        "tool_installed_or_adapter_removed",
        "remote_answers_with_box_key",
        "install_wrote_hook_entries",
        "install_copied_skill_for_this_version",
        "sandbox_present_or_executor_sandbox_none",
        "executor_sets_the_named_variables",
        "executor_and_producer_keys_set_and_enrolled",
        "keys_on_hardware_or_outside_the_session_account",
        "release_reachable",
        "release_republished",
        "pin_moved",
        "talk_corrected_or_superseded",
        "pushed_commit_promotable",
        "view_reaches_no_lane_commit",
        "approved",
        "a_live_change_lands_or_is_abandoned",
        "free_space_above_floor",
        "hold_cleared",
        "paths_declared",
        "dependencies_landed",
        "dependency_dropped_or_restarted",
        "change_within_limits"
      ]
    },
    "next_step": {
      "type": "string"
    },
    "waiting_for": {
      "type": "string"
    },
    "elapsed_s": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt": {
      "type": "string"
    },
    "freshness": {
      "type": "object",
      "required": [
        "trunk",
        "fetched_at"
      ],
      "additionalProperties": false,
      "properties": {
        "trunk": {
          "type": "string"
        },
        "fetched_at": {
          "type": "string"
        }
      }
    }
  }
}
