{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bay.result/1",
  "description": "The one result every bay command prints on stdout.",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "say"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "reason": [
      "allowed",
      "retry_when",
      "next_step"
    ]
  },
  "properties": {
    "schema": {
      "const": "bay.result/1"
    },
    "op_id": {
      "type": "string"
    },
    "candidate": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "ok",
        "merged",
        "queued",
        "blocked",
        "failed"
      ]
    },
    "state": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "INPUT_CHANGED",
        "INPUT_UNOBSERVED",
        "MERGE_CONFLICT",
        "MAIN_MOVED",
        "MERGE_RETRY_EXHAUSTED",
        "REGISTRY_CHANGED",
        "REGISTRY_UNREADABLE",
        "CHECK_FLAKY",
        "CHANGE_NOT_MERGED",
        "HOOK_TIMEOUT",
        "QUEUED",
        "QUEUE_DEADLINE_EXCEEDED",
        "CHECK_FAILED",
        "CHECK_UNAVAILABLE",
        "CHECK_UNKNOWN",
        "POLICY_CHANGED",
        "POLICY_INVALID",
        "POLICY_MISSING",
        "VIEW_INCOMPLETE",
        "MERGE_OUTCOME_UNKNOWN",
        "MAIN_RED",
        "CHANGE_ALREADY_MERGED",
        "CHANGE_SUPERSEDED",
        "CHANGE_HELD",
        "ABANDON_REFUSED",
        "ACTOR_UNNAMED",
        "ACTOR_UNPROVEN",
        "COVERAGE_UNKNOWN",
        "HOOK_INPUT_INVALID",
        "SHELL_DENIED",
        "PATH_HELD",
        "LOCK_NOT_HELD",
        "REMOTE_NOT_FETCHED",
        "CONFIG_MISSING",
        "TOOL_BELOW_FLOOR",
        "TOOL_ABSENT",
        "REMOTE_UNREACHABLE",
        "HOOKS_MISSING",
        "SKILL_MISMATCH",
        "SANDBOX_ABSENT",
        "CHECK_ENV_UNSET",
        "RUNNER_KEY_MISSING",
        "KEY_EXPOSED",
        "UPDATE_UNAVAILABLE",
        "UPDATE_UNVERIFIED",
        "UPDATE_PINNED",
        "TALK_REFUSED",
        "OUTSIDE_MERGE",
        "EVIDENCE_WITHDRAWN",
        "PROMOTION_REFUSED",
        "LANE_LEAK",
        "APPROVAL_PENDING",
        "WIP_LIMIT",
        "DISK_LOW",
        "MAIN_HELD",
        "PATHS_UNDECLARED",
        "DEPENDENCY_PENDING",
        "DEPENDENCY_ABANDONED",
        "CHANGE_TOO_LARGE"
      ]
    },
    "say": {
      "type": "string"
    },
    "change": {
      "type": "string"
    },
    "detail": {},
    "allowed": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "refresh",
          "repair",
          "wait"
        ]
      }
    },
    "retry_when": {
      "enum": [
        "after_fix",
        "by_itself",
        "after_setup",
        "after_wait",
        "after_new_main",
        "never",
        "after_person"
      ]
    },
    "next_step": {
      "type": "string"
    },
    "waiting_for": {
      "type": "string"
    },
    "elapsed_s": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt": {
      "type": "string"
    },
    "freshness": {
      "type": "object",
      "required": [
        "main",
        "fetched_at"
      ],
      "additionalProperties": false,
      "properties": {
        "main": {
          "type": "string"
        },
        "fetched_at": {
          "type": "string"
        }
      }
    }
  }
}
